{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": ".build",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "noEmit": false
  },
  "include": ["lib/bundle/**/*.ts", "lib/params.ts", "lib/migrate.ts", "lib/auto.ts", "lib/sell-all.ts"]
}
