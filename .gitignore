# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env* !.env.local.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# M2 generated artifacts (devnet-only test keys)
.build/
scripts/dev-wallets.json
*PROMPT*.md
*BASE*.md
MILESTONES.md
HANDOFF.md
*-DEPLOY.md
*REVIEW*

# Solana / Anchor (generated build artifacts + deploy secrets)
.anchor/
/target/*
# The client imports the IDL JSON directly (lib/idl.ts) and CI (Vercel) has
# no anchor toolchain, so the generated IDL must be committed. Everything
# else under target/ stays ignored.
!/target/idl/
/target/idl/*
!/target/idl/pumpfun.json
.verify-shots/
