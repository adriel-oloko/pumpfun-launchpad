# Solana RPC pools (consumed by lib/rpc/rpc-pool.ts).
# Each var accepts a comma-separated list; every entry is prepended to that
# network's pool ahead of the public defaults (devnet.helius-rpc.com/?api-key=6fd05d57-a073-4cc6-8b5b-4314a652e487 /
# api.mainnet-beta.solana.com, operated by Triton).
#
# M7b PREREQUISITE: mainnet launches and the bundle smoke run on a KEYED RPC.
# Copy .env.local (the working config) and paste a real Helius/Triton key, or
# keep the public defaults for read-only devnet work.
#
# Helius (keyed):
#   NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
#
# Triton (keyed, dedicated):
#   NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://mainnet.rpcpool.com
#   NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://devnet.rpcpool.com

NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Cluster switch (lib/network.ts): mainnet | devnet (default devnet).
# Set NEXT_PUBLIC_SOLANA_NETWORK=mainnet to move the WHOLE client (RPC pool,
# pump.fun fee recipient, explorer links) onto mainnet. Prereqs: a keyed
# mainnet RPC above + a MAINNET-funded creator wallet. Left unset, the app
# stays on devnet for rehearsals.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Rate limiter tuning (lib/rpc/rpc-limiter.ts).
# NEXT_PUBLIC_RPC_MAX_CONCURRENCY=8
# NEXT_PUBLIC_RPC_MAX_RATE=20

# Fee policy knobs (lib/fees.ts). Priority fee = micro-lamports per compute
# unit: 1_000_000 = 1 lamport/CU, about 0.0002 SOL per 200k-CU tx. The
# default floor (1 lamport/CU) is landable on devnet and a sane mainnet base;
# memecoin competition usually needs 5-20x more
# (RECOMMENDED_MAINNET_PRIORITY_FEE_MICRO_LAMPORTS = 10_000_000 in lib/fees.ts).
# Relay (bundle) tip = absolute lamports placed in the LAST bundle tx:
# 1_000_000 = 0.001 SOL, the minimum BOTH active Tier 2 relays require
# (Astralane free tier + bloXroute docs). Mainnet recommends ~5_000_000
# (0.005 SOL) under competition. Submissions happen once at the configured
# tip (no escalation).
# NEXT_PUBLIC_PRIORITY_FEE_MICRO_LAMPORTS=1000000
# NEXT_PUBLIC_JITO_TIP_LAMPORTS=1000000  # name kept for env compat; feeds the
#                                        # Tier 2 relay tip default (0.001 SOL)

# ---- Tier 2 atomic-launch relays (server-side secrets) ------------------
# Tier 2 (the Launch panel's atomic-bundle mode) submits the launch bundle
# through the same-origin proxy (app/api/bundle-relay/route.ts) to Astralane
# Iris PRIMARY first, then bloXroute as an OPTIONAL fallback — sequentially,
# bloXroute only when Astralane explicitly rejects or is unreachable. Each
# relay receives its OWN provider-specific signed bundle (the browser
# assembles a variant per relay paying THAT relay's recognized tip account:
# Astralane `astra...` / bloXroute `bLx...` wallets; a Jito-tipped bundle is
# never shared across relays). Jito is NOT part of the active Tier 2 path.
#
# These are SERVER secrets: they must live in server env (NOT with the
# NEXT_PUBLIC_ prefix, which Next inlines into the browser bundle). A relay
# without credentials is reported "disabled" and is never fired. Without ANY
# of them Tier 2 reports the honest not-configured state after assembling +
# simulating (nothing is created, nothing is fabricated).
#
# Astralane Iris (PRIMARY; required for Tier 2 submission): the API key from
# portal.astralane.io. Docs: astralane.gitbook.io/docs/low-latency. Free tier
# min tip 0.001 SOL; sendBundle up to 4 txs. Appended as ?api-key= to
# ASTRALANE_URL (default https://edge.astralane.io/iris; regional gateways
# like https://fr.gateway.astralane.io/iris also work and are recommended).
# ASTRALANE_API_KEY=
# ASTRALANE_URL=https://edge.astralane.io/iris
#
# bloXroute Solana Trader API (OPTIONAL FALLBACK): paste the exact
# Authorization header value from the bloXroute account portal (Account
# Details) verbatim; it is usually "Bearer eyJ..." or the raw JWT depending
# on the account tier. Docs: docs.bloxroute.com/solana/trader-api. Bundles
# (useBundle=true) cap at 4 txs, need a >= 0.001 SOL tip to an official
# bloXroute wallet, and are submitted with frontRunningProtection enabled.
# BLOXROUTE_JWT=
# BLOXROUTE_URL=https://ny.solana.dex.blxrbdn.com/api/v2/submit-batch
#
# Legacy Jito (NOT in the active Tier 2 order): RELAY_JITO_URL overrides the
# open block engine (default https://mainnet.block-engine.jito.wtf/api/v1)
# for the diagnostic smoke / live probe / legacy status polling only.
# RELAY_JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1
#
# Jito-Solana RPC (legacy diagnostics): the PUBLIC block engine does NOT
# populate getBundleStatuses' rejection_reason (returns value: []) and
# removed simulateBundle (-32601). A Jito-Solana RPC serves BOTH. Helius is
# the free option (Jito methods are included on the standard endpoint, no
# add-on); Quicknode "Lil Jit" and Triton also work. Set JITO_RPC_URL to that
# endpoint's root (the JSON-RPC URL, NOT the /bundles path). Server-side
# secret, no NEXT_PUBLIC_ prefix. Used by GET /api/bundle-relay?action=status
# (legacy jito bundles) and POST /api/jito-simulate (simulateBundle).
# Helius (reuse your existing mainnet key):
# JITO_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#
# Per-relay timeout for the sequential submission (ms) and the request body
# cap. The timeout bounds EACH relay attempt; with bloXroute as the fallback,
# a worst-case rejection path waits ~2 x RELAY_TIMEOUT_MS.
# RELAY_TIMEOUT_MS=12000
# RELAY_MAX_BODY_BYTES=1048576

# ---- M9: token metadata publish backend (server-side secrets) ----------
# The launch panel's Advanced section now collects structured metadata
# (description / image file / website / X-twitter / telegram) and on Launch
# the same-origin route app/api/metadata/publish uploads the composed JSON
# (+ image) here and returns the on-chain uri. These are SERVER secrets:
# NO NEXT_PUBLIC_ prefix. The engine + both dialects are documented in
# lib/metadata-publish.ts; the VPS receiver runbook + systemd unit live in
# tools/metadata-vps/server.mjs.
#
# MAINNET ANSWER: VPS primary (operator owns the box, no recurring pinning
# bill, image + JSON colocated under one stable URL). Archive each token's
# JSON + image to IPFS/Arweave at launch as insurance (the on-chain uri is
# immutable). ipfs (Pinata) is the switchable second backend or the primary
# when a pinning service is preferred.
#
# VPS backend (preferred):
# METADATA_BACKEND=vps
# METADATA_VPS_UPLOAD_URL=https://metadata.example.com/put
# METADATA_VPS_BASE_URL=https://metadata.example.com
# METADATA_VPS_SECRET=<long random string shared with the receiver>
#
# IPFS backend (Pinata):
# METADATA_BACKEND=ipfs
# PINATA_JWT=<pinata api key>
# PINATA_GATEWAY=https://ipfs.io/ipfs
#
# Tuning:
# METADATA_MAX_IMAGE_BYTES=5242880
