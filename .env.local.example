# Solana RPC pools (consumed by lib/rpc/rpc-pool.ts).
# Each var accepts a comma-separated list; every entry is prepended to that
# network's pool ahead of the public defaults (devnet.helius-rpc.com/?api-key=6fd05d57-a073-4cc6-8b5b-4314a652e487 /
# api.mainnet-beta.solana.com, operated by Triton).
#
# M7b PREREQUISITE: mainnet launches and the bundle smoke run on a KEYED RPC.
# Copy .env.local (the working config) and paste a real Helius/Triton key, or
# keep the public defaults for read-only devnet work.
#
# Helius (keyed):
#   NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
#
# Triton (keyed, dedicated):
#   NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://mainnet.rpcpool.com
#   NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://devnet.rpcpool.com

NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Rate limiter tuning (lib/rpc/rpc-limiter.ts).
# NEXT_PUBLIC_RPC_MAX_CONCURRENCY=8
# NEXT_PUBLIC_RPC_MAX_RATE=20

# Fee policy knobs (lib/fees.ts). Priority fee = micro-lamports per compute
# unit: 1_000_000 = 1 lamport/CU, about 0.0002 SOL per 200k-CU tx. The
# default floor (1 lamport/CU) is landable on devnet and a sane mainnet base;
# memecoin competition usually needs 5-20x more
# (RECOMMENDED_MAINNET_PRIORITY_FEE_MICRO_LAMPORTS = 10_000_000 in lib/fees.ts).
# Jito tip = absolute lamports in the last bundle tx: 1_000_000 = 0.001 SOL.
# Mainnet recommends ~5_000_000 (0.005 SOL) and the bundle layer escalates
# the tip 2x per failed attempt.
# NEXT_PUBLIC_PRIORITY_FEE_MICRO_LAMPORTS=1000000
# NEXT_PUBLIC_JITO_TIP_LAMPORTS=1000000

# ---- M7b: bundle relay fan-out (server-side secrets) -------------------
# The same-origin proxy (app/api/bundle-relay/route.ts) fans the launch
# bundle out to Jito (primary, OPEN endpoint: always enabled) + bloXroute +
# Astralane in parallel, first-accept-wins. bloXroute needs a JWT and
# Astralane needs an API key. These are SERVER secrets: they must live in
# server env (NOT with the NEXT_PUBLIC_ prefix, which Next inlines into the
# browser bundle). A relay without credentials is reported "disabled" and is
# never fired, so the fan-out works with Jito alone.
#
# Jito: open. RELAY_JITO_URL overrides the block engine (default
# https://mainnet.block-engine.jito.wtf/api/v1) for rehearsals/mocks.
# RELAY_JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1
#
# bloXroute Solana Trader API: paste the exact Authorization header value
# from the bloXroute account portal (Account Details) verbatim; it is usually
# "Bearer eyJ..." or the raw JWT depending on the account tier.
# BLOXROUTE_JWT=
# BLOXROUTE_URL=https://ny.solana.dex.blxrbdn.com/api/v2/submit-batch
#
# Astralane Iris: the API key from portal.astralane.io. Bundles need a paid
# tier (the free tier has 0 TPS on sendBundle). The key is appended as
# ?api-key= to ASTRALANE_URL (default https://edge.astralane.io/iris).
# ASTRALANE_API_KEY=
# ASTRALANE_URL=https://edge.astralane.io/iris
#
# Per-leg timeout for the fan-out (ms) and the request body cap.
# RELAY_TIMEOUT_MS=12000
# RELAY_MAX_BODY_BYTES=1048576
